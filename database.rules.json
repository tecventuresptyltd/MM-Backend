{
  "rules": {
    "lobbies": {
      "$lobbyId": {
        ".read": "auth != null",
        "members": {
          "$uid": {
            "cosmeticsInfo": {
              ".write": "auth != null && auth.uid === $uid"
            },
            "isReady": {
              ".write": "auth != null && auth.uid === $uid"
            }
          }
        },
        "mapVoting": {
          "votes": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "activeMapIndices": {
            ".write": "auth != null && auth.uid === root.child('lobbies').child($lobbyId).child('hostUid').val()"
          },
          "winnerIndex": {
            ".write": "auth != null && auth.uid === root.child('lobbies').child($lobbyId).child('hostUid').val()"
          }
        },
        "launchSceneName": {
          ".write": "auth != null && auth.uid === root.child('lobbies').child($lobbyId).child('hostUid').val()"
        },
        "matchmakingStatus": {
          ".write": "auth != null && auth.uid === root.child('lobbies').child($lobbyId).child('hostUid').val()"
        }
      }
    },
    "users": {
      "$uid": {
        "invitations": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null"
        }
      }
    },
    "chat_messages": {
      "clans": {
        "$clanId": {
          ".indexOn": [
            "ts"
          ],
          ".read": "auth != null",
          ".write": false,
          "$messageId": {
            ".read": "auth != null"
          }
        }
      },
      "global": {
        "$roomId": {
          ".indexOn": [
            "ts"
          ],
          ".read": "auth != null && root.child('presence/online').child(auth.uid).child('roomId').val() === $roomId",
          ".write": false
        }
      }
    },
    "presence": {
      "online": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null"
        }
      }
    }
  }
}