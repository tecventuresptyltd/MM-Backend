{
  "rules": {
    "lobbies": {
      "$lobbyId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "users": {
      "$uid": {
        "invitations": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null"
        }
      }
    },
    "chat_messages": {
      "clans": {
        "$clanId": {
          ".indexOn": [
            "ts"
          ],
          ".read": "auth != null",
          ".write": false,
          "$messageId": {
            ".read": "auth != null"
          }
        }
      },
      "global": {
        "$roomId": {
          ".indexOn": [
            "ts"
          ],
          ".read": "auth != null && root.child('presence/online').child(auth.uid).child('roomId').val() === $roomId",
          ".write": false
        }
      }
    },
    "presence": {
      "online": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null"
        }
      }
    }
  }
}